#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -f src/global.json ]; then
  cd src && dotnet restore --locked-mode && cd ..
fi

if [ -f .config/dotnet-tools.json ]; then
  dotnet tool restore
fi

if [ -f package.json ] && [ -d .husky ]; then
  npx husky install .husky
fi

echo "post-create complete"
