# Force LF line endings for files that must run on Linux
* text=auto eol=lf

# Windows-only files — keep CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.cs            text eol=crlf
*.ps1           text eol=crlf

# Other text files
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Markdown files
*.md    text eol=lf